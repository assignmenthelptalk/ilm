---
interface LevelCard {
  code: string;
  title: string;
  meta: string;
  description: string;
  href: string;
}

const levels: LevelCard[] = [
  {
    code: 'L3',
    title: 'Team Leading & Leadership',
    meta: 'Award · Certificate · Diploma',
    description:
      'The most commonly studied entry point — first-line supervisors and team leaders applying leadership theory to their own workplace practice.',
    href: '/ilm-level-3-assignment-help/',
  },
  {
    code: 'L5',
    title: 'Leadership & Management',
    meta: 'Award · Certificate · Diploma',
    description:
      'Middle management level — critical analysis, Harvard referencing, and strategic recommendations grounded in real organisational evidence.',
    href: '/ilm-level-5-assignment-help/',
  },
  {
    code: 'L7',
    title: 'Senior Leadership & Executive Management',
    meta: 'Award · Certificate · Diploma',
    description:
      'Postgraduate-level strategic analysis for senior leaders — critical synthesis of multiple theoretical frameworks and executive-level recommendations.',
    href: '/ilm-level-7-assignment-help/',
  },
];
---

<section class="core-levels">
  <div class="container">
    <p class="core-levels__eyebrow">ILM Leadership &amp; Management — Core Levels</p>
    <h2 class="core-levels__heading">Three Levels, One Specialist Team</h2>
    <p class="core-levels__subheading">
      Level 3, Level 5, and Level 7 make up the core of the ILM leadership and management pathway.
      Each level has its own assessment standard, unit structure, and evidence depth — our writers
      work exclusively within ILM's criteria at every level.
    </p>
    <div class="core-levels__grid">
      {levels.map((level) => (
        <a href={level.href} class="core-levels__card">
          <span class="core-levels__badge">Core Level</span>
          <div class="core-levels__code">{level.code}</div>
          <div class="core-levels__title">{level.title}</div>
          <div class="core-levels__meta">{level.meta}</div>
          <p class="core-levels__desc">{level.description}</p>
          <span class="core-levels__cta">Get Assignment Help →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .core-levels {
    background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    padding: 3.5rem 0;
    border-top: 4px solid var(--color-accent);
    border-bottom: 4px solid var(--color-accent);
  }

  .core-levels__eyebrow {
    text-align: center;
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .core-levels__heading {
    text-align: center;
    color: var(--color-white);
    font-size: 1.9rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .core-levels__subheading {
    text-align: center;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    max-width: 680px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .core-levels__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .core-levels__card {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 215, 0, 0.25);
    border-radius: 10px;
    padding: 1.75rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-decoration: none;
    color: inherit;
    transition: background 0.25s, border-color 0.25s, transform 0.25s;
    cursor: pointer;
  }

  .core-levels__card:hover {
    background: rgba(255, 215, 0, 0.1);
    border-color: var(--color-accent);
    transform: translateY(-3px);
  }

  .core-levels__badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
    background: var(--color-accent);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    margin-bottom: 0.5rem;
    align-self: flex-start;
  }

  .core-levels__code {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-accent);
    line-height: 1.1;
  }

  .core-levels__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-white);
    line-height: 1.3;
  }

  .core-levels__meta {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
    font-weight: 500;
    margin-bottom: 0.4rem;
  }

  .core-levels__desc {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.65;
    flex-grow: 1;
  }

  .core-levels__cta {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-accent);
    align-self: flex-start;
  }

  @media (max-width: 900px) {
    .core-levels__grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .core-levels__heading {
      font-size: 1.55rem;
    }
  }

  @media (max-width: 600px) {
    .core-levels {
      padding: 2.5rem 0;
    }

    .core-levels__heading {
      font-size: 1.35rem;
    }

    .core-levels__subheading {
      font-size: 0.92rem;
    }
  }
</style>
