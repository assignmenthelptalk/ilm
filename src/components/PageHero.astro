---
interface Props {
  badge: string;
  crumbLabel: string;
  h1: string;
  intro?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const { badge, crumbLabel, h1, intro, ctaLabel, ctaHref } = Astro.props;
---

<section class="page-hero">
  <div class="container">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol class="breadcrumb__list">
        <li><a href="/">Home</a></li>
        <li aria-current="page">{crumbLabel}</li>
      </ol>
    </nav>
    <div class="page-hero__content">
      <span class="page-hero__badge">{badge}</span>
      <h1 class="page-hero__h1">{h1}</h1>
      {intro && <p class="page-hero__intro">{intro}</p>}
      {ctaLabel && ctaHref && (
        <a href={ctaHref} class="page-hero__cta">{ctaLabel} →</a>
      )}
    </div>
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-bg-dark) 100%);
    padding: 3.5rem 0 3rem;
    color: var(--color-white);
  }
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb__list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.65);
  }
  .breadcrumb__list li + li::before { content: '/'; margin-right: 0.5rem; }
  .breadcrumb__list a { color: rgba(255, 255, 255, 0.75); }
  .breadcrumb__list a:hover { color: var(--color-white); }

  .page-hero__content { max-width: 760px; }
  .page-hero__badge {
    display: inline-block;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    margin-bottom: 1rem;
  }
  .page-hero__h1 {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-white);
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }
  .page-hero__intro {
    font-size: 1.0625rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    max-width: 620px;
    margin-bottom: 1.75rem;
  }
  .page-hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background-color: var(--color-accent);
    color: var(--color-primary);
    font-weight: 700;
    border-radius: 0.375rem;
    transition: background-color 0.2s;
  }
  .page-hero__cta:hover { background-color: var(--color-accent-dark); }

  @media (max-width: 540px) {
    .page-hero { padding: 2.5rem 0 2rem; }
  }
</style>
